{
    "name": "phpstats/juphyter",
    "description": "A Jupyter and Quarto kernel for PHP, built for statistical work with the phpstats packages",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "jupyter",
        "quarto",
        "kernel",
        "notebook",
        "repl",
        "statistics"
    ],
    "authors": [
        {
            "name": "Erik Westlund"
        }
    ],
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "phpstats/phibble": "Data frames shown as notebook tables",
        "phpstats/phplyr": "dplyr-style pipelines over phibble data frames",
        "phpstats/phiz": "Plots shown as notebook charts",
        "ext-pcntl": "Interrupting a running cell with the stop button"
    },
    "autoload": {
        "psr-4": {
            "Juphyter\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Juphyter\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/juphyter"
    ],
    "scripts": {
        "test": "pest",
        "lint": [
            "phpcs",
            "@test:sniffs"
        ],
        "test:sniffs": "php tools/phpcs/selftest/run.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phibble",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phplyr",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phiz",
            "no-api": true
        }
    ]
}
