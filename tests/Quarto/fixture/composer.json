{
    "name": "juphyter/render-fixture",
    "description": "The notebook project the render tests build, so that juphyter's own manifest and vendor directory stay at the none-installed set",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "phpstats/phibble": "^0.3",
        "phpstats/phplyr": "^0.3",
        "phpstats/phiz": "^0.3"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phibble",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phplyr",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phiz",
            "no-api": true
        }
    ]
}
